DATABASE_URL=postgresql://user:password@host:port/cinema_auth

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

REDIS_URL=redis://user:password@host:port

KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_API_KEY=
KAFKA_API_SECRET=
# group_id del consumer de Kafka. Dev y prod comparten el mismo cluster de
# Confluent Cloud -- en local usa SIEMPRE un sufijo distinto (ej. "-local")
# para no unirte al mismo grupo de consumidores que produccion.
KAFKA_GROUP_ID=auth-service-group-local

PYTHON_VERSION=3.12
